{
  "name": "mycryptoportfolio",
  "compatibility_date": "2026-10-06",
  "main": "platform/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /api/* だけ Worker のコードを通す。ポータル・ログイン画面・SDK は静的ファイルとして無料で配信
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Workshop と同じ OAuth クライアント（公開してよい値。SPEC-001 4.3）
    "GOOGLE_CLIENT_ID": "757389530825-7kee3d573nk0b03iv9mc0qeq8952kf5n.apps.googleusercontent.com",
    "COOKIE_DOMAIN": ".bearko.games"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bearko-platform",
      "database_id": "387e2f22-d55e-4ddd-bcc1-bdb072f68a55",
      "migrations_dir": "migrations"
    }
  ],
  // 毎日 4:00（日本時間）に期限切れのセッションと古い仮アカウントを消す
  "triggers": { "crons": ["0 19 * * *"] }
}
