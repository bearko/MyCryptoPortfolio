{
  "name": "mycryptoportfolio",
  "compatibility_date": "2026-10-06",
  "main": "platform/worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /api/* だけ Worker のコードを通す。ポータル・ログイン画面・SDK は静的ファイルとして無料で配信
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Workshop と同じ OAuth クライアント（公開してよい値。SPEC-001 4.3）
    "GOOGLE_CLIENT_ID": "757389530825-7kee3d573nk0b03iv9mc0qeq8952kf5n.apps.googleusercontent.com",
    "COOKIE_DOMAIN": ".bearko.games"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bearko-platform",
      "database_id": "387e2f22-d55e-4ddd-bcc1-bdb072f68a55",
      "migrations_dir": "migrations"
    }
  ],
  // 全体チャットの部屋（SPEC-004）。SQLite つきの Durable Object（無料プランで使える種類）
  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
  // 毎日 4:00（日本時間）に期限切れのセッションと古い仮アカウントを消す
  "triggers": { "crons": ["0 19 * * *"] },
  // 本番以外のブランチ（プレビュー）のビルドで `wrangler preview` を使うために必要。
  // 空なので、プレビューには本番の D1・変数・シークレットはつながらない（本番のデータに書き込まない）
  "previews": {}
}
